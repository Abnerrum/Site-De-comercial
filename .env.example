# ===== BANCO DE DADOS =====
DB_HOST=localhost
DB_PORT=3306
DB_NAME=loja_virtual
DB_USER=root
DB_PASS=

# ===== APLICAÇÃO =====
SITE_NOME=Loja Virtual
SITE_URL=http://localhost:8000
APP_ENV=development

# ===== EMAIL (para verificação de conta e recuperação de senha) =====
MAIL_DRIVER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USER=seu_usuario_mailtrap
MAIL_PASS=sua_senha_mailtrap
MAIL_FROM=noreply@lojavirtual.com
MAIL_FROM_NAME=Loja Virtual

# ===== SEGURANÇA =====
SESSION_TIMEOUT=1800
PASSWORD_MIN_LENGTH=8
TOKEN_EXPIRY=3600

# ===== PAGAMENTO (para integração futura) =====
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=

# ===== FRETE (configuração de taxas) =====
FRETE_GRATIS_ACIMA_DE=299
FRETE_PADRAO=25
